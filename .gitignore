# Dependencies
node_modules/
*/node_modules/
**/node_modules/

# Environment Variables & Secrets
# Strictly ignore all .env files anywhere in the project (root, client/.env, server/.env, etc.)
.env
.env.*
*.env
**/.env
**/.env.*
**/*.env
client/.env
client/.env.*
server/.env
server/.env.*

# Retain template example files so contributors have configuration references
!**/.env.example
!.env.example

# Production Build Artifacts
dist/
dist-ssr/
build/
client/dist/

# Logs & Diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Editor Configurations
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-project
*.sublime-workspace

# Temporary & Cache Directories
.eslintcache
.stylelintcache
.turbo/
.cache/
.temp/
.tmp/
